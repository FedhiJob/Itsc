generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
  CONTENT_EDITOR
  TRAINING_MANAGER
  NEWS_EDITOR
  VIEWER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

model Administrator {
  id               String            @id @default(uuid()) @db.Uuid
  fullName         String            @map("full_name") @db.VarChar(150)
  email            String            @unique @db.VarChar(255)
  passwordHash     String            @map("password_hash") @db.Text
  role             AdminRole         @default(ADMIN)
  status           Boolean           @default(true)
  lastLogin        DateTime?         @map("last_login")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  trainingPrograms TrainingProgram[]
  newsArticles     NewsArticle[]

  @@map("administrators")
}

model TrainingCategory {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(100)
  slug        String             @unique @db.VarChar(120)
  description String?            @db.Text
  parentId    String?            @map("parent_id") @db.Uuid
  sortOrder   Int                @default(0) @map("sort_order")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  parent      TrainingCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    TrainingCategory[] @relation("CategoryHierarchy")
  programs    TrainingProgram[]

  @@index([parentId])
  @@map("training_categories")
}

model TrainingProgram {
  id               String           @id @default(uuid()) @db.Uuid
  categoryId       String           @map("category_id") @db.Uuid
  authorId         String?          @map("author_id") @db.Uuid
  title            String           @db.VarChar(255)
  slug             String           @unique @db.VarChar(255)
  code             String?          @db.VarChar(50)
  shortDescription String           @map("short_description") @db.Text
  fullDescription  String           @map("full_description") @db.Text
  duration         String?          @db.VarChar(50)
  deliveryMode     String?          @map("delivery_mode") @db.VarChar(50)
  level            String?          @db.VarChar(50)
  featuredImage    String?          @map("featured_image") @db.Text
  outlineText      String?          @map("outline_text") @db.Text
  outlineFileUrl   String?          @map("outline_file_url") @db.Text
  isFeatured       Boolean          @default(false) @map("is_featured")
  sortOrder        Int              @default(0) @map("sort_order")
  objectives       String[]         @default([])
  prerequisites    String[]         @default([])
  status           ContentStatus    @default(DRAFT)
  deletedAt        DateTime?        @map("deleted_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  author           Administrator?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category         TrainingCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@map("training_programs")
}

model NewsArticle {
  id            String         @id @default(uuid()) @db.Uuid
  authorId      String?        @map("author_id") @db.Uuid
  title         String         @db.VarChar(255)
  slug          String         @unique @db.VarChar(255)
  summary       String         @db.Text
  content       String         @db.Text
  category      String?        @db.VarChar(100)
  featuredImage String?        @map("featured_image") @db.Text
  publishedAt   DateTime?      @map("published_at")
  status        ContentStatus  @default(DRAFT)
  deletedAt     DateTime?      @map("deleted_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  author        Administrator? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishedAt])
  @@index([category])
  @@map("news_articles")
}

model GalleryAlbum {
  id          String         @id @default(uuid()) @db.Uuid
  title       String         @db.VarChar(255)
  slug        String         @unique @db.VarChar(255)
  description String?        @db.Text
  coverImage  String?        @map("cover_image") @db.Text
  isFeatured  Boolean        @default(false) @map("is_featured")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  images      GalleryImage[]

  @@map("gallery_albums")
}

model GalleryImage {
  id         String       @id @default(uuid()) @db.Uuid
  albumId    String       @map("album_id") @db.Uuid
  imageUrl   String       @map("image_url") @db.Text
  caption    String?      @db.Text
  altText    String       @map("alt_text") @db.VarChar(255)
  sortOrder  Int          @default(0) @map("sort_order")
  uploadedAt DateTime     @default(now()) @map("uploaded_at")
  album      GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@index([albumId, sortOrder])
  @@map("gallery_images")
}

model ContactInquiry {
  id           String        @id @default(uuid()) @db.Uuid
  fullName     String        @map("full_name") @db.VarChar(150)
  email        String        @db.VarChar(255)
  phone        String?       @db.VarChar(50)
  organization String?       @db.VarChar(255)
  subject      String        @db.VarChar(255)
  message      String        @db.Text
  sourcePage   String?       @map("source_page") @db.VarChar(500)
  sourceLabel  String?       @map("source_label") @db.VarChar(255)
  status       InquiryStatus @default(NEW)
  submittedAt  DateTime      @default(now()) @map("submitted_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([submittedAt])
  @@map("contact_inquiries")
}

model WebsiteSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(120)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("website_settings")
}

enum LogoType {
  PARTNER
  CLIENT
}

model TrustLogo {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(150)
  logoUrl    String   @map("logo_url") @db.Text
  websiteUrl String?  @map("website_url") @db.Text
  type       LogoType
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([type, isActive])
  @@map("trust_logos")
}
